{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hanlinlibham/dual-loop-dev/schemas/rule-proposal-v1.json",
  "title": "Dual-Loop Governance Rule Proposal",
  "description": "Outer-loop policy evolution proposal anchored to immutable review failure hashes.",
  "type": "object",
  "required": [
    "proposal_id",
    "feedback_ids",
    "previous_policy_sha256",
    "problem",
    "change",
    "scope",
    "counterexample",
    "validation_cases",
    "rollback"
  ],
  "properties": {
    "proposal_id": { "type": "string", "minLength": 1 },
    "feedback_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 8 }
    },
    "previous_policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "problem": { "type": "string", "minLength": 1 },
    "change": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "counterexample": { "type": "string", "minLength": 1 },
    "validation_cases": {
      "type": "array",
      "minItems": 2,
      "description": "At least two independent tasks must validate a rule before promotion to default policy.",
      "items": { "type": "string", "minLength": 1 }
    },
    "rollback": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
