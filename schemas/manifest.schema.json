{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hanlinlibham/dual-loop-dev/schemas/manifest-v1.json",
  "title": "Dual-Loop Round Execution Manifest",
  "description": "Frozen single-attempt round specification issued by the supervisor.",
  "type": "object",
  "required": [
    "repo",
    "case_root",
    "profile",
    "allowed_paths",
    "protected_paths",
    "policy_files",
    "checks",
    "max_rounds"
  ],
  "properties": {
    "round_kind": {
      "enum": ["development", "verification"],
      "default": "development",
      "description": "Verification reruns all checks on the unchanged prior candidate without an implementation agent."
    },
    "parent_round": {
      "type": "integer",
      "minimum": 1,
      "description": "Immediately preceding rejected round; required for verification."
    },
    "expected_candidate_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the parent round's archived candidate.json; required for verification."
    },
    "repo": {
      "type": "string",
      "description": "Absolute path to the Git worktree root."
    },
    "case_root": {
      "type": "string",
      "description": "Absolute path to the frozen contract directory outside repo."
    },
    "contract_script": {
      "type": "string",
      "description": "Optional absolute path to contract.py (defaults to bundled scripts/contract.py)."
    },
    "taskkit_script": {
      "type": "string",
      "description": "Backward-compatible alias for an external TaskKit scripts/contract.py."
    },
    "profile": {
      "type": "string",
      "description": "Absolute path to the project profile.json."
    },
    "require_clean_worktree": {
      "type": "boolean"
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protected_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policy_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "argv"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cwd": {
            "type": "string"
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "max_rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    }
  },
  "allOf": [
    {
      "if": {"properties": {"round_kind": {"const": "verification"}}, "required": ["round_kind"]},
      "then": {"required": ["parent_round", "expected_candidate_sha256"]},
      "else": {"not": {"anyOf": [{"required": ["parent_round"]}, {"required": ["expected_candidate_sha256"]}]}}
    }
  ],
  "additionalProperties": true
}
